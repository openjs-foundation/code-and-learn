# Copy to .env and fill in. Never commit .env.

# GitHub OAuth app credentials (Settings > Developer settings > OAuth Apps).
# The app's "Authorization callback URL" must be:
#   <public origin>/oauth/github/callback   (production)
#   http://localhost:9926/oauth/github/callback  (local dev)
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Public origin + /oauth/callback. Leave unset for local dev (defaults to
# http://localhost:9926/oauth/callback); REQUIRED on Harper Fabric.
OAUTH_REDIRECT_URI=

# Comma-separated GitHub logins seeded as admins on their first sign-in.
# Existing admins can promote more people from /admin.
ADMIN_GITHUB_LOGINS=

# --- Local development only -------------------------------------------------

# The synthetic fixture set (fixtures/): tasks in every state, guides, users,
# and settings. Local instances only; existing records are left untouched.
#LOCAL_SEED=fixtures

# One or more JSON task files (comma-separated) loaded as the starting pool —
# the curated event lists or the admin bulk-import shape.
# Idempotent: entries already loaded are left untouched.
#LOCAL_DATA_FILE=data/contribution-tasks.json,data/manual.json

# Path to the per-theme guide file (data/contribution-guides.json). Guides are
# the shared how-to each task references by its theme.
#LOCAL_GUIDES_FILE=data/contribution-guides.json

# Sign in as a test user without GitHub: the nav's Dev menu, or
# POST /api/dev/login {"as": "fx_alice"}. Local instances only, and only for logins with
# an underscore (never a real GitHub account). Pairs with LOCAL_SEED.
#LOCAL_DEV_SIGN_IN=true
